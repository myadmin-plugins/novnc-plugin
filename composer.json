{
	"name": "detain/myadmin-novnc-plugin",
	"type": "myadmin-plugin",
	"description": "NoVNC HTML5 VNC connection handling plugin for the MyAdmin control panel framework",
	"keywords": [
		"novnc",
		"vnc",
		"html5",
		"remote-desktop",
		"myadmin",
		"plugin"
	],
	"license": "LGPL-2.1-only",
	"authors": [
		{
			"name": "Joe Huss",
			"homepage": "https://my.interserver.net/"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"bin-dir": "vendor/bin",
		"allow-plugins": {
			"detain/myadmin-plugin-installer": true
		}
	},
	"require": {
		"php": ">=8.2",
		"ext-soap": "*",
		"symfony/event-dispatcher": "^5.0||^6.0||^7.0",
		"detain/myadmin-plugin-installer": "dev-feature/plugin-contract-testcase"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Detain\\MyAdminNovnc\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Detain\\MyAdminNovnc\\Tests\\": "tests/"
		}
	},
	"extra": {
		"myadmin-deferred-contract-defects": {
			"B-10": {
				"until": "2026-11-30",
				"issue": "plugin_plan.md Phase 5, Bucket 1 (scaffold-copied abuse.inc.php family)",
				"findings": [
					"requirement \"class.Novnc\" registers /../vendor/detain/myadmin-novnc-plugin/src/Novnc.php",
					"requirement \"deactivate_kcare\" registers /../vendor/detain/myadmin-novnc-plugin/src/abuse.inc.php",
					"requirement \"deactivate_abuse\" registers /../vendor/detain/myadmin-novnc-plugin/src/abuse.inc.php",
					"requirement \"get_abuse_licenses\" registers /../vendor/detain/myadmin-novnc-plugin/src/abuse.inc.php"
				]
			}
		}
	}
}
